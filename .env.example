# Copy this file to .env.local for local development
# Set production values via: wrangler pages secret put VAR_NAME

# Public (safe to expose to browser)
PUBLIC_SUPABASE_URL=https://kbilecibimkkouenojpj.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
PUBLIC_SITE_URL=https://sendcrypto.io

# Server-only (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
HMAC_SECRET=generate_random_64_char_string_here
PARTNER_API_SALT=generate_random_64_char_string_here

# Optional: Worker URLs (defaults to same domain)
SUBSCRIBE_WORKER_URL=https://sendcrypto.io/api/subscribe
AFFILIATE_WORKER_URL=https://sendcrypto.io/api/affiliate-click
