---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}
const { title, description, canonical, ogImage = 'https://sendcrypto.io/og-image.png', ogType = 'website', jsonLd, publishedTime, modifiedTime, noindex = false } = Astro.props;
const pathname = Astro.url.pathname;
const canonicalUrl = canonical || `https://sendcrypto.io${pathname}`;
Astro.response.headers.set('X-Content-Type-Options', 'nosniff');
Astro.response.headers.set('X-Frame-Options', 'DENY');
Astro.response.headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
Astro.response.headers.set('Permissions-Policy', 'geolocation=(), microphone=(), camera=(), payment=()');
Astro.response.headers.set('Strict-Transport-Security', 'max-age=63072000; includeSubDomains; preload');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="SendCrypto.io" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://kbilecibimkkouenojpj.supabase.co" />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <style is:global>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --gold:#F5C842;--gold-dim:rgba(245,200,66,.12);--gold-glow:rgba(245,200,66,.35);
      --purple:#7C5CFC;--purple-dim:rgba(124,92,252,.12);
      --bg:#0A0812;--bg2:#0E0C18;
      --surface:rgba(255,255,255,.04);--surface2:rgba(255,255,255,.07);
      --border:rgba(255,255,255,.08);--border-gold:rgba(245,200,66,.22);
      --text:#F8F5FF;--text-muted:rgba(248,245,255,.5);--text-dim:rgba(248,245,255,.28);
      --positive:#3DFFC0;--negative:#FF5C7A;
      --fd:'Outfit',sans-serif;--fm:'DM Mono',monospace;
    }
    html{scroll-behavior:smooth}
    body{font-family:var(--fd);background:var(--bg);color:var(--text);overflow-x:hidden;line-height:1.7}
    a{color:var(--gold);text-decoration:none}
    a:hover{text-decoration:underline}

    /* Cookie Banner */
    #cookie-banner{position:fixed;bottom:0;left:0;right:0;background:rgba(10,8,18,0.98);border-top:1px solid var(--border-gold);padding:20px 40px;z-index:9999;backdrop-filter:blur(16px);display:none}
    #cookie-banner.show{display:block}
    #cookie-banner .cb-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
    #cookie-banner h3{font-size:.95rem;font-weight:700;margin-bottom:4px;color:var(--text)}
    #cookie-banner p{font-size:.8rem;color:var(--text-muted);max-width:600px;line-height:1.6}
    #cookie-banner p a{color:var(--gold)}
    #cookie-banner .cb-actions{display:flex;gap:10px;flex-wrap:wrap}
    #cookie-banner button{padding:9px 18px;border-radius:6px;font-family:var(--fd);font-weight:600;font-size:.8rem;cursor:pointer;border:none;transition:all .2s}
    .cb-accept{background:linear-gradient(135deg,var(--gold),#FFB347);color:#0A0812}
    .cb-reject{background:transparent;color:var(--text);border:1px solid var(--border)!important}
    .cb-customize{background:transparent;color:var(--text-muted);border:1px solid var(--border)!important;font-size:.72rem!important}
    @media(max-width:768px){#cookie-banner{padding:16px 20px}#cookie-banner .cb-inner{flex-direction:column;align-items:flex-start}}
  </style>
</head>
<body>
  <slot name="nav" />
  <slot />
  <slot name="footer" />

  <div id="cookie-banner" role="dialog" aria-labelledby="cookie-title">
    <div class="cb-inner">
      <div>
        <h3 id="cookie-title">Privacy & Cookie Preferences</h3>
        <p>We use essential cookies for site functionality. With your consent, analytics cookies help us improve the platform. We never sell your data. <a href="/privacy/">Privacy Policy</a> · <a href="/cookies/">Cookie Policy</a></p>
      </div>
      <div class="cb-actions">
        <button class="cb-reject" onclick="window.SC_cookies('reject')">Reject All</button>
        <button class="cb-customize" onclick="window.location.href='/cookies/'">Customize</button>
        <button class="cb-accept" onclick="window.SC_cookies('accept')">Accept All</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function() {
      const KEY = 'sc_consent_v1';
      const consent = localStorage.getItem(KEY);
      window.SC_cookies = function(action) {
        localStorage.setItem(KEY, JSON.stringify({ status: action, timestamp: new Date().toISOString(), version: 1 }));
        document.getElementById('cookie-banner').classList.remove('show');
        if (action === 'accept') window.SC_analytics_enabled = true;
      };
      window.SC_getConsent = function() { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; } };
      if (!consent) {
        setTimeout(() => document.getElementById('cookie-banner').classList.add('show'), 1500);
      } else {
        try {
          const data = JSON.parse(consent);
          const age = Date.now() - new Date(data.timestamp).getTime();
          if (age > 365 * 24 * 60 * 60 * 1000) { localStorage.removeItem(KEY); setTimeout(() => document.getElementById('cookie-banner').classList.add('show'), 1500); }
          else if (data.status === 'accept') window.SC_analytics_enabled = true;
        } catch {}
      }
    })();
  </script>
</body>
</html>