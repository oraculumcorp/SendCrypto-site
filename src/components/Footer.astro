---
const year = new Date().getFullYear();
---
<footer>
  <div class="footer-inner">
    <div class="fi">
      <div class="flogo">Send<span>Crypto</span>.io</div>
      <ul class="flinks">
        <li><a href="/#compare">Compare</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/company/">Company</a></li>
        <li><a href="/partners/">Partners</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/cookies/">Cookies</a></li>
      </ul>
    </div>
    <div class="disclosure">
      <strong>Affiliate Disclosure:</strong> SendCrypto.io may earn affiliate commissions from licensed providers when you click through and complete transactions. This does not increase your cost and does not influence our organic comparison rankings. Sponsored placements are clearly labeled. <a href="/company/">Full disclosure →</a>
    </div>
    <div class="disclaimer">
      <strong>Rate Disclaimer:</strong> Exchange rates are for comparison purposes only and subject to change without notice. Always confirm the final rate directly on the provider's platform before initiating a transfer. SendCrypto.io is a comparison platform — not a licensed money transmitter. We do not hold, transmit, or settle funds.
    </div>
    <div class="fcopy">© {year} SendCrypto.io — All rights reserved.</div>
  </div>
</footer>

<style>
  footer{position:relative;z-index:1;padding:60px 40px 40px;border-top:1px solid var(--border);background:rgba(14,12,24,.8)}
  .footer-inner{max-width:1200px;margin:0 auto}
  .fi{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:24px;margin-bottom:32px}
  .flogo{font-family:var(--fd);font-size:1.1rem;font-weight:800;color:var(--text)}
  .flogo span{background:linear-gradient(135deg,var(--gold),#FFB347);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  .flinks{display:flex;gap:20px;list-style:none;flex-wrap:wrap}
  .flinks a{color:var(--text-muted);text-decoration:none;font-size:.82rem;transition:color .2s}
  .flinks a:hover{color:var(--text)}
  .disclosure,.disclaimer{font-family:var(--fm);font-size:.7rem;color:var(--text-dim);line-height:1.7;padding:14px 18px;background:var(--surface);border:1px solid var(--border);border-radius:8px;margin-bottom:10px}
  .disclosure strong,.disclaimer strong{color:var(--gold);display:block;margin-bottom:4px;text-transform:uppercase;letter-spacing:.08em;font-size:.65rem}
  .disclosure a{color:var(--gold)}
  .fcopy{font-family:var(--fm);font-size:.68rem;color:var(--text-dim);margin-top:20px;text-align:center}
  @media(max-width:768px){footer{padding:40px 20px}.fi{flex-direction:column;align-items:flex-start}}
</style>