---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Partner API | SendCrypto.io | Ethical Access for AI Agents and Agencies" description="Request structured API access to SendCrypto.io rate data, corridor intelligence, and content. For ethical AI agents, research firms, and partner agencies.">
  <Nav slot="nav" />
  <main>
    <div class="ltag">// partners</div>
    <h1>Partner API Access</h1>
    <p class="lede">Structured access to SendCrypto.io rate intelligence, corridor data, and blog content for ethical AI agents, research firms, financial publications, and partner agencies. Free for non-commercial use with attribution. Commercial tiers available.</p>

    <h2>What We Offer</h2>
    <ul>
      <li><strong>rates-summary</strong> — Live rate data across 50 platform-corridor pairs</li>
      <li><strong>corridor-data</strong> — Top 5 platforms ranked for each major corridor</li>
      <li><strong>blog-feed</strong> — Latest 20 published articles with metadata</li>
    </ul>

    <h2>Authentication</h2>
    <p>Every request must include an <code>X-Partner-Key</code> header. Keys are issued after manual review of your use case and signed terms agreement. We log every request and audit usage quarterly.</p>

    <h2>Acceptable Use</h2>
    <ul>
      <li>Attribute SendCrypto.io as the data source on every public output</li>
      <li>Link back to sendcrypto.io where attribution is shown</li>
      <li>Respect rate limits (1,000 requests/day default tier)</li>
      <li>Do not redistribute raw API responses to third parties without permission</li>
      <li>Do not use data to compete directly with SendCrypto.io's core comparison product</li>
    </ul>

    <h2>Request Access</h2>
    <p>Email <a href="mailto:partners@sendcrypto.io">partners@sendcrypto.io</a> with:</p>
    <ul>
      <li>Your organization name and website</li>
      <li>Your use case (research, AI agent training, content publication, etc.)</li>
      <li>Expected request volume</li>
      <li>How you will attribute SendCrypto.io</li>
    </ul>
    <p>We review requests within 5 business days.</p>

    <h2>Why This Matters</h2>
    <p>We believe that high-quality, licensed financial data should be accessible to ethical researchers, journalists, and AI systems that follow attribution standards. We do not allow scraping or unauthorized harvesting — but we actively welcome partners who commit to responsible use.</p>

    <h2>Pricing Tiers</h2>
    <ul>
      <li><strong>Research / Non-Profit:</strong> Free with attribution. 1,000 requests/day.</li>
      <li><strong>AI Training / Academic:</strong> Free with attribution and signed terms. 5,000 requests/day.</li>
      <li><strong>Commercial Integration:</strong> Custom pricing. Unlimited rate limits. SLA available.</li>
    </ul>
  </main>
  <Footer slot="footer" />
  <style>
    main{position:relative;z-index:1;max-width:820px;margin:0 auto;padding:140px 40px 100px}
    .ltag{font-family:'DM Mono',monospace;font-size:.72rem;color:var(--accent);letter-spacing:.12em;text-transform:uppercase;margin-bottom:16px}
    h1{font-size:2.5rem;font-weight:800;letter-spacing:-.03em;line-height:1.1;margin-bottom:20px}
    .lede{font-size:1.1rem;color:rgba(240,244,255,.85);margin-bottom:48px;padding-bottom:32px;border-bottom:1px solid var(--border);line-height:1.75}
    h2{font-size:1.05rem;font-weight:700;color:var(--accent);margin:40px 0 14px;letter-spacing:.02em;text-transform:uppercase}
    p{color:rgba(240,244,255,.8);margin-bottom:16px;font-size:.95rem;line-height:1.75}
    ul{margin:0 0 16px 20px;color:rgba(240,244,255,.8);font-size:.95rem}
    ul li{margin-bottom:10px;line-height:1.7}
    strong{color:var(--text)}
    code{background:var(--surface);padding:2px 8px;border-radius:4px;font-family:'DM Mono',monospace;font-size:.85rem;color:var(--accent)}
    a{color:var(--accent)}
    @media(max-width:768px){main{padding:100px 20px 60px}}
  </style>
</BaseLayout>
