---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getPublicClient } from "../lib/supabase";

const supabase = getPublicClient(Astro.locals.runtime?.env || import.meta.env);

const { data: rates } = await supabase
  .from("rates")
  .select("rate, fee_pct, speed_minutes, providers(name, slug)")
  .eq("corridor", "US-MX")
  .eq("from_asset", "USDT")
  .eq("to_currency", "MXN")
  .order("rate", { ascending: false })
  .limit(6);

const { data: prices } = await supabase
  .from("coingecko_prices")
  .select("symbol, price, price_change_24h")
  .order("fetched_at", { ascending: false })
  .limit(4);

const safeRates = rates || [];
const safePrices = prices || [];
const maxRate = safeRates[0]?.rate || 0;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "SendCrypto.io",
  "url": "https://sendcrypto.io",
  "description": "Compare real-time crypto-to-fiat exchange rates across 10+ licensed platforms.",
};
---
<BaseLayout
  title="SendCrypto.io — Send Crypto. Get Cash. Instantly."
  description="Compare real-time crypto-to-fiat rates across 10+ licensed platforms. Free. No account needed. Best rate, every time."
  jsonLd={jsonLd}
>
  <Nav slot="nav" />

  <section class="hero">
    <div class="hero-orb orb-1"></div>
    <div class="hero-orb orb-2"></div>
    <div class="hero-orb orb-3"></div>
    <div class="hero-mesh"></div>

    <div class="hero-left">
      <div class="hero-tag">
        <span class="tag-dot"></span>
        Live rates &middot; 15 min refresh
      </div>
      <h1 class="hero-headline">
        <span class="line-1">Send Crypto.</span>
        <span class="line-2">Get <em>Cash.</em></span>
        <span class="line-3">Instantly.</span>
      </h1>
      <p class="hero-sub">Compare real-time crypto-to-fiat rates across 10+ licensed platforms. Free. No account. Best rate, every time.</p>
      <div class="hero-actions">
        <a href="#compare" class="btn-primary">
          <span>Compare Rates Now</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#rates" class="btn-ghost">Get Rate Alerts</a>
      </div>
      <div class="hero-proof">
        <div class="proof-item">
          <span class="proof-num">10+</span>
          <span class="proof-lbl">Platforms</span>
        </div>
        <div class="proof-div"></div>
        <div class="proof-item">
          <span class="proof-num">40+</span>
          <span class="proof-lbl">Corridors</span>
        </div>
        <div class="proof-div"></div>
        <div class="proof-item">
          <span class="proof-num">$0</span>
          <span class="proof-lbl">To compare</span>
        </div>
        <div class="proof-div"></div>
        <div class="proof-item">
          <span class="proof-num">15m</span>
          <span class="proof-lbl">Refresh</span>
        </div>
      </div>
    </div>

    <div class="hero-right">
      <div class="rate-card">
        <div class="rate-card-header">
          <div class="rc-corridor">
            <span class="flag">US</span>
            <span class="corridor-arrow">&rarr;</span>
            <span class="flag">MX</span>
            <span class="corridor-label">US to Mexico &middot; USDT/MXN</span>
          </div>
          <div class="rc-live">
            <span class="live-dot"></span>
            Live
          </div>
        </div>
        <div class="rate-rows">
          {safeRates.slice(0, 4).map((r: any, i: number) => {
            const rowClass = i === 0 ? "rate-row rate-row--best" : "rate-row";
            const rspeed = r.speed_minutes <= 1 ? "Instant" : ("~" + r.speed_minutes + "m");
            return (
              <div class={rowClass}>
                <div class="rr-left">
                  {i === 0 && <span class="best-tag">Best</span>}
                  <span class="rr-name">{r.providers?.name || "Provider"}</span>
                </div>
                <div class="rr-right">
                  <span class="rr-rate">{Number(r.rate).toLocaleString()} MXN</span>
                  <span class="rr-fee">{r.fee_pct}% &middot; {rspeed}</span>
                </div>
              </div>
            );
          })}
          {safeRates.length === 0 && <div class="rc-loading">Loading live rates...</div>}
        </div>
        <div class="rate-card-footer">
          Refreshes every 15 minutes &middot; <a href="#compare">See all platforms</a>
        </div>
      </div>
      <div class="trust-badges">
        <div class="badge">Licensed only</div>
        <div class="badge">Real-time data</div>
        <div class="badge">40+ corridors</div>
      </div>
    </div>
  </section>

  {safePrices.length > 0 && (
    <div class="ticker-belt">
      <div class="ticker-inner">
        {[...safePrices, ...safePrices].map((c: any) => {
          const up = (c.price_change_24h || 0) >= 0;
          const pct = Math.abs(c.price_change_24h || 0).toFixed(2);
          const cprice = c.price >= 1000 ? ("\$" + Number(c.price).toLocaleString()) : ("\$" + Number(c.price).toFixed(4));
          const chgClass = up ? "tick-chg up" : "tick-chg dn";
          const valClass = up ? "tick-val up" : "tick-val dn";
          const arrow = up ? "+" : "-";
          return (
            <div class="tick-item">
              <span class="tick-sym">{c.symbol}/USD</span>
              <span class={valClass}>{cprice}</span>
              <span class={chgClass}>{arrow}{pct}%</span>
            </div>
          );
        })}
      </div>
    </div>
  )}

  <section class="compare-section" id="compare">
    <div class="section-label">Live Comparison</div>
    <h2 class="section-title">Best Rates <em>Right Now</em></h2>
    <p class="section-sub">USDT to MXN &middot; Updated {new Date().toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit" })}</p>

    <div class="compare-table">
      <div class="ct-head">
        <span>Platform</span>
        <span>Rate</span>
        <span>Fee</span>
        <span>Speed</span>
        <span>Score</span>
        <span></span>
      </div>
      {safeRates.map((r: any, i: number) => {
        const score = Math.round((r.rate / maxRate) * 100);
        const tspeed = r.speed_minutes <= 1 ? "Instant" : ("~" + r.speed_minutes + " min");
        const rowCls = i === 0 ? "ct-row ct-row--best" : "ct-row";
        const scoreStyle = "width:" + score + "%";
        return (
          <div class={rowCls}>
            <div class="ct-platform">
              {i === 0 && <span class="ct-badge">Best</span>}
              <span class="ct-name">{r.providers?.name || "Provider"}</span>
            </div>
            <div class="ct-rate">
              {Number(r.rate).toLocaleString()}
              <span class="ct-curr"> MXN</span>
            </div>
            <div class="ct-fee">{r.fee_pct}%</div>
            <div class="ct-speed">{tspeed}</div>
            <div class="ct-score">
              <div class="score-bar">
                <div class="score-fill" style={scoreStyle}></div>
              </div>
            </div>
            <button class="ct-btn" data-provider={r.providers?.slug} data-corridor="US-MX" data-asset="USDT">
              Convert
            </button>
          </div>
        );
      })}
      {safeRates.length === 0 && (
        <div class="ct-empty">Loading live rates &mdash; refresh in a moment.</div>
      )}
    </div>

    <div class="feature-cards">
      <div class="fc">
        <div class="fc-icon">&#9889;</div>
        <h3>Real-Time Rates</h3>
        <p>Every platform refreshed every 15 minutes. No cached data. No stale quotes.</p>
      </div>
      <div class="fc">
        <div class="fc-icon">&#128274;</div>
        <h3>Licensed Only</h3>
        <p>We only list regulated, licensed providers. Your funds go to compliant platforms.</p>
      </div>
      <div class="fc">
        <div class="fc-icon">&#127758;</div>
        <h3>40+ Corridors</h3>
        <p>US to Mexico, Nigeria, Philippines, Brazil, Kenya and growing every month.</p>
      </div>
    </div>
  </section>

  <section class="subscribe-section" id="rates">
    <div class="sub-orb"></div>
    <div class="sub-inner">
      <div class="section-label">Free Weekly Intel</div>
      <h2 class="sub-title">The Crypto Remittance<br /><em>Rate Bible</em></h2>
      <p class="sub-desc">Best rates for 10 corridors &mdash; updated weekly. 2,000+ operators already use it. Free. Always.</p>
      <form id="subscribe-form" class="sub-form" novalidate>
        <div class="sub-input-wrap">
          <input type="email" name="email" placeholder="your@email.com" required autocomplete="email" class="sub-input" />
          <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
          <button type="submit" class="sub-btn">Get Free Rates</button>
        </div>
        <label class="sub-consent">
          <input type="checkbox" id="consent-check" required />
          <span>I agree to the weekly Rate Bible. <a href="/privacy/">Privacy Policy</a>. Unsubscribe anytime.</span>
        </label>
      </form>
      <div class="sub-promise">Zero spam &middot; Encrypted at rest &middot; Never sold</div>
      <div class="sub-success" id="subscribe-success">Check your inbox to confirm your subscription.</div>
      <div class="sub-error" id="subscribe-error"></div>
    </div>
  </section>

  <Footer slot="footer" />

  <style>
    @import url("https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=DM+Mono:wght@300;400;500&display=swap");

    :root {
      --gold: #F5C842;
      --gold-dim: rgba(245,200,66,.12);
      --gold-glow: rgba(245,200,66,.35);
      --purple: #7C5CFC;
      --purple-dim: rgba(124,92,252,.12);
      --bg: #0A0812;
      --surface: rgba(255,255,255,.04);
      --surface2: rgba(255,255,255,.07);
      --border: rgba(255,255,255,.08);
      --border-gold: rgba(245,200,66,.22);
      --text: #F8F5FF;
      --text-muted: rgba(248,245,255,.5);
      --text-dim: rgba(248,245,255,.28);
      --positive: #3DFFC0;
      --negative: #FF5C7A;
      --fd: "Outfit", sans-serif;
      --fm: "DM Mono", monospace;
    }

    .hero { position:relative; min-height:100vh; display:grid; grid-template-columns:1fr 1fr; align-items:center; padding:120px 60px 80px; gap:60px; overflow:hidden; z-index:1; }
    .hero-mesh { position:absolute; inset:0; background-image:linear-gradient(rgba(245,200,66,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(245,200,66,.025) 1px,transparent 1px); background-size:48px 48px; pointer-events:none; mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,black 40%,transparent 100%); }
    .hero-orb { position:absolute; border-radius:50%; filter:blur(80px); pointer-events:none; }
    .orb-1 { width:500px; height:500px; background:radial-gradient(circle,rgba(124,92,252,.16) 0%,transparent 70%); top:-10%; left:-5%; animation:orbFloat 12s ease-in-out infinite; }
    .orb-2 { width:400px; height:400px; background:radial-gradient(circle,rgba(245,200,66,.1) 0%,transparent 70%); top:20%; right:0%; animation:orbFloat 16s ease-in-out infinite reverse; }
    .orb-3 { width:300px; height:300px; background:radial-gradient(circle,rgba(124,92,252,.08) 0%,transparent 70%); bottom:0%; left:40%; animation:orbFloat 20s ease-in-out infinite; }
    @keyframes orbFloat { 0%,100% { transform:translate(0,0) scale(1); } 33% { transform:translate(20px,-30px) scale(1.05); } 66% { transform:translate(-15px,20px) scale(.95); } }
    .hero-left { position:relative; z-index:2; }
    .hero-tag { display:inline-flex; align-items:center; gap:8px; background:var(--gold-dim); border:1px solid var(--border-gold); border-radius:100px; padding:7px 16px; font-family:var(--fm); font-size:.72rem; color:var(--gold); letter-spacing:.08em; text-transform:uppercase; margin-bottom:36px; }
    .tag-dot { width:6px; height:6px; background:var(--gold); border-radius:50%; animation:pulse 2s infinite; }
    @keyframes pulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:.4; transform:scale(.8); } }
    .hero-headline { display:flex; flex-direction:column; gap:2px; margin-bottom:28px; }
    .line-1,.line-2,.line-3 { font-family:var(--fd); font-size:clamp(2.6rem,5.5vw,5rem); font-weight:800; letter-spacing:-.03em; line-height:1.05; color:var(--text); }
    .line-2 em { font-style:normal; background:linear-gradient(135deg,var(--gold) 0%,#FFB347 50%,var(--purple) 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
    .line-3 { font-weight:300; color:transparent; -webkit-text-stroke:1px rgba(248,245,255,.18); }
    .hero-sub { font-family:var(--fd); font-size:1.05rem; color:var(--text-muted); max-width:480px; line-height:1.75; margin-bottom:40px; }
    .hero-actions { display:flex; gap:14px; flex-wrap:wrap; margin-bottom:64px; }
    .btn-primary { display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg,var(--gold),#FFB347); color:#0A0812; font-family:var(--fd); font-weight:700; font-size:.95rem; padding:15px 30px; border-radius:8px; text-decoration:none; transition:all .2s; }
    .btn-primary:hover { transform:translateY(-2px); box-shadow:0 8px 32px var(--gold-glow); text-decoration:none; }
    .btn-ghost { display:inline-flex; align-items:center; gap:10px; background:var(--surface); color:var(--text); font-family:var(--fd); font-weight:600; font-size:.95rem; padding:15px 30px; border-radius:8px; text-decoration:none; border:1px solid var(--border); transition:all .2s; }
    .btn-ghost:hover { border-color:rgba(248,245,255,.2); background:var(--surface2); text-decoration:none; }
    .hero-proof { display:flex; gap:32px; align-items:center; flex-wrap:wrap; }
    .proof-item { display:flex; flex-direction:column; gap:2px; }
    .proof-num { font-family:var(--fd); font-size:1.8rem; font-weight:800; background:linear-gradient(135deg,var(--gold),var(--purple)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; letter-spacing:-.02em; }
    .proof-lbl { font-family:var(--fm); font-size:.62rem; color:var(--text-dim); letter-spacing:.12em; text-transform:uppercase; }
    .proof-div { width:1px; height:36px; background:var(--border); }
    .hero-right { position:relative; z-index:2; }
    .rate-card { background:rgba(14,12,24,.85); border:1px solid var(--border-gold); border-radius:20px; padding:28px; backdrop-filter:blur(20px); box-shadow:0 32px 64px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.05); position:relative; overflow:hidden; }
    .rate-card::before { content:""; position:absolute; top:-1px; left:20%; right:20%; height:1px; background:linear-gradient(90deg,transparent,var(--gold),transparent); }
    .rate-card-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
    .rc-corridor { display:flex; align-items:center; gap:8px; font-family:var(--fm); font-size:.72rem; color:var(--text-muted); letter-spacing:.06em; }
    .flag { font-size:.85rem; font-weight:700; color:var(--text-muted); }
    .corridor-arrow { color:var(--gold); font-weight:700; }
    .corridor-label { color:var(--text-dim); }
    .rc-live { display:flex; align-items:center; gap:6px; font-family:var(--fm); font-size:.65rem; color:var(--positive); letter-spacing:.1em; text-transform:uppercase; }
    .live-dot { width:6px; height:6px; background:var(--positive); border-radius:50%; animation:pulse 1.5s infinite; }
    .rate-rows { display:flex; flex-direction:column; gap:8px; }
    .rate-row { display:flex; align-items:center; justify-content:space-between; padding:14px 16px; background:var(--surface); border-radius:10px; border:1px solid var(--border); transition:all .2s; }
    .rate-row:hover { border-color:rgba(248,245,255,.12); background:var(--surface2); }
    .rate-row--best { background:linear-gradient(135deg,rgba(245,200,66,.07),rgba(124,92,252,.05)); border-color:var(--border-gold); box-shadow:0 0 20px rgba(245,200,66,.05); }
    .rr-left { display:flex; align-items:center; gap:8px; }
    .rr-name { font-family:var(--fd); font-weight:700; font-size:.9rem; color:var(--text); }
    .best-tag { font-family:var(--fm); font-size:.58rem; font-weight:600; color:var(--gold); background:var(--gold-dim); border:1px solid var(--border-gold); padding:2px 7px; border-radius:100px; letter-spacing:.08em; text-transform:uppercase; }
    .rr-right { text-align:right; }
    .rr-rate { font-family:var(--fm); font-size:.95rem; font-weight:500; color:var(--gold); display:block; }
    .rr-fee { font-family:var(--fm); font-size:.68rem; color:var(--text-dim); }
    .rc-loading { padding:24px; text-align:center; font-family:var(--fm); font-size:.78rem; color:var(--text-dim); }
    .rate-card-footer { margin-top:16px; padding-top:16px; border-top:1px solid var(--border); font-family:var(--fm); font-size:.65rem; color:var(--text-dim); text-align:center; }
    .rate-card-footer a { color:var(--gold); text-decoration:none; }
    .trust-badges { display:flex; gap:8px; margin-top:16px; flex-wrap:wrap; }
    .badge { font-family:var(--fm); font-size:.62rem; color:var(--text-muted); background:var(--surface); border:1px solid var(--border); border-radius:100px; padding:5px 12px; letter-spacing:.04em; }
    .ticker-belt { position:relative; z-index:1; overflow:hidden; padding:12px 0; background:rgba(245,200,66,.03); border-top:1px solid rgba(245,200,66,.08); border-bottom:1px solid rgba(245,200,66,.08); }
    .ticker-inner { display:flex; animation:scroll 30s linear infinite; width:max-content; }
    @keyframes scroll { from { transform:translateX(0); } to { transform:translateX(-50%); } }
    .tick-item { display:flex; align-items:center; gap:8px; padding:0 32px; font-family:var(--fm); font-size:.75rem; white-space:nowrap; border-right:1px solid var(--border); }
    .tick-sym { color:var(--text-muted); font-weight:500; }
    .tick-val.up,.tick-chg.up { color:var(--positive); }
    .tick-val.dn,.tick-chg.dn { color:var(--negative); }
    .tick-chg { font-size:.65rem; }
    .compare-section { position:relative; z-index:1; padding:100px 60px; max-width:1300px; margin:0 auto; }
    .section-label { font-family:var(--fm); font-size:.7rem; color:var(--gold); letter-spacing:.16em; text-transform:uppercase; margin-bottom:14px; }
    .section-title { font-family:var(--fd); font-size:clamp(2rem,4vw,3rem); font-weight:800; color:var(--text); letter-spacing:-.03em; line-height:1.1; margin-bottom:12px; }
    .section-title em { font-style:normal; background:linear-gradient(135deg,var(--gold),var(--purple)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
    .section-sub { font-family:var(--fm); font-size:.8rem; color:var(--text-muted); margin-bottom:48px; }
    .compare-table { border:1px solid var(--border); border-radius:16px; overflow:hidden; background:var(--surface); margin-bottom:48px; }
    .ct-head { display:grid; grid-template-columns:2fr 1.5fr 1fr 1fr 1fr 130px; padding:14px 24px; background:rgba(245,200,66,.04); border-bottom:1px solid var(--border); font-family:var(--fm); font-size:.65rem; color:var(--text-dim); letter-spacing:.12em; text-transform:uppercase; }
    .ct-row { display:grid; grid-template-columns:2fr 1.5fr 1fr 1fr 1fr 130px; padding:18px 24px; align-items:center; border-bottom:1px solid var(--border); transition:background .15s; }
    .ct-row:last-child { border-bottom:none; }
    .ct-row:hover { background:var(--surface2); }
    .ct-row--best { background:linear-gradient(135deg,rgba(245,200,66,.06),rgba(124,92,252,.04)); border-left:2px solid var(--gold); }
    .ct-platform { display:flex; align-items:center; gap:8px; }
    .ct-name { font-family:var(--fd); font-weight:700; font-size:.95rem; color:var(--text); }
    .ct-badge { font-family:var(--fm); font-size:.6rem; color:var(--gold); background:var(--gold-dim); border:1px solid var(--border-gold); padding:2px 8px; border-radius:100px; letter-spacing:.06em; }
    .ct-rate { font-family:var(--fm); font-size:.95rem; font-weight:600; color:var(--gold); }
    .ct-curr { font-size:.75rem; color:var(--text-dim); }
    .ct-fee,.ct-speed { font-family:var(--fm); font-size:.82rem; color:var(--text-muted); }
    .score-bar { height:4px; background:rgba(255,255,255,.08); border-radius:2px; overflow:hidden; }
    .score-fill { height:100%; background:linear-gradient(90deg,var(--gold),var(--purple)); border-radius:2px; }
    .ct-btn { display:inline-flex; align-items:center; justify-content:center; background:linear-gradient(135deg,var(--gold-dim),var(--purple-dim)); border:1px solid var(--border-gold); color:var(--gold); font-family:var(--fd); font-size:.78rem; font-weight:700; padding:9px 18px; border-radius:6px; cursor:pointer; transition:all .2s; }
    .ct-btn:hover { box-shadow:0 0 16px var(--gold-glow); transform:translateY(-1px); }
    .ct-empty { padding:40px; text-align:center; font-family:var(--fm); font-size:.8rem; color:var(--text-dim); }
    .feature-cards { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
    .fc { padding:28px; background:var(--surface); border:1px solid var(--border); border-radius:14px; transition:all .2s; }
    .fc:hover { border-color:var(--border-gold); background:var(--surface2); transform:translateY(-2px); }
    .fc-icon { font-size:1.5rem; margin-bottom:14px; display:block; }
    .fc h3 { font-family:var(--fd); font-size:1rem; font-weight:700; color:var(--text); margin-bottom:8px; }
    .fc p { font-size:.85rem; color:var(--text-muted); line-height:1.65; }
    .subscribe-section { position:relative; z-index:1; padding:100px 60px; text-align:center; overflow:hidden; }
    .sub-orb { position:absolute; width:600px; height:600px; background:radial-gradient(circle,rgba(124,92,252,.1) 0%,transparent 70%); top:50%; left:50%; transform:translate(-50%,-50%); pointer-events:none; }
    .sub-inner { position:relative; z-index:2; max-width:560px; margin:0 auto; }
    .sub-title { font-family:var(--fd); font-size:clamp(2rem,4vw,3rem); font-weight:800; color:var(--text); letter-spacing:-.03em; line-height:1.15; margin-bottom:16px; }
    .sub-title em { font-style:normal; background:linear-gradient(135deg,var(--gold),var(--purple)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
    .sub-desc { font-size:1rem; color:var(--text-muted); line-height:1.7; margin-bottom:40px; }
    .sub-input-wrap { display:flex; border:1px solid var(--border-gold); border-radius:10px; overflow:hidden; background:rgba(14,12,24,.8); backdrop-filter:blur(10px); margin-bottom:14px; transition:box-shadow .2s; }
    .sub-input-wrap:focus-within { box-shadow:0 0 0 3px rgba(245,200,66,.12); }
    .sub-input { flex:1; background:transparent; border:none; outline:none; padding:16px 20px; font-family:var(--fm); font-size:.88rem; color:var(--text); }
    .sub-input::placeholder { color:var(--text-dim); }
    .sub-btn { background:linear-gradient(135deg,var(--gold),#FFB347); color:#0A0812; font-family:var(--fd); font-weight:700; font-size:.88rem; border:none; padding:16px 24px; cursor:pointer; white-space:nowrap; transition:all .2s; }
    .sub-btn:hover { filter:brightness(1.08); }
    .sub-consent { display:flex; align-items:flex-start; gap:10px; text-align:left; font-size:.78rem; color:var(--text-muted); line-height:1.5; }
    .sub-consent input { margin-top:3px; flex-shrink:0; }
    .sub-consent a { color:var(--gold); }
    .sub-promise { margin-top:16px; font-family:var(--fm); font-size:.65rem; color:var(--text-dim); letter-spacing:.08em; }
    .sub-success { margin-top:16px; font-family:var(--fm); font-size:.82rem; color:var(--positive); display:none; }
    .sub-error { margin-top:16px; font-family:var(--fm); font-size:.82rem; color:var(--negative); display:none; }
    @media(max-width:768px) {
      .hero { grid-template-columns:1fr; padding:100px 24px 60px; gap:40px; }
      .hero-right { display:none; }
      .compare-section,.subscribe-section { padding:60px 24px; }
      .ct-head,.ct-row { grid-template-columns:2fr 1fr 1fr; }
      .ct-head > *:nth-child(n+4),.ct-row > *:nth-child(n+4) { display:none; }
      .feature-cards { grid-template-columns:1fr; }
      .sub-input-wrap { flex-direction:column; }
    }
  </style>

  <script>
    document.getElementById("subscribe-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const consent = (document.getElementById("consent-check") as HTMLInputElement)?.checked;
      const errorEl = document.getElementById("subscribe-error") as HTMLElement;
      const successEl = document.getElementById("subscribe-success") as HTMLElement;
      errorEl.style.display = "none";
      successEl.style.display = "none";
      if (!consent) {
        errorEl.textContent = "Please confirm consent to subscribe.";
        errorEl.style.display = "block";
        return;
      }
      const formData = new FormData(form);
      const email = formData.get("email") as string;
      const honeypot = formData.get("website") as string;
      if (honeypot) return;
      try {
        const res = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email,
            source: "homepage_hero",
            consent_copy: "I agree to receive the weekly Rate Bible newsletter and understand I can unsubscribe at any time.",
            consent_timestamp: new Date().toISOString(),
          }),
        });
        const data = await res.json();
        if (data.success) {
          form.style.display = "none";
          successEl.style.display = "block";
        } else {
          errorEl.textContent = data.error || "Subscription failed. Please try again.";
          errorEl.style.display = "block";
        }
      } catch {
        errorEl.textContent = "Connection error. Please try again.";
        errorEl.style.display = "block";
      }
    });

    document.querySelectorAll(".ct-btn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const target = e.currentTarget as HTMLElement;
        const slug = target.dataset.provider;
        const corridor = target.dataset.corridor;
        const asset = target.dataset.asset;
        if (!slug) return;
        fetch("/api/affiliate-click", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ provider_slug: slug, corridor, asset }),
        }).catch(() => {});
        const sid = Math.random().toString(36).substring(2, 11);
        window.open("/api/redirect?p=" + slug + "&c=" + corridor + "&a=" + asset + "&s=" + sid, "_blank", "noopener,noreferrer");
      });
    });
  </script>
</BaseLayout>